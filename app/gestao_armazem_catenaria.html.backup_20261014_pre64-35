let _NOMES_PECAS=null;
/* Junta os nomes que o programa conhece para cada cÃ³digo de peÃ§a. O catÃ¡logo manda;
   depois as listas de peÃ§as confirmadas e por fim os BOM das montagens. */
function nomesPecasConhecidos(){
  if(_NOMES_PECAS)return _NOMES_PECAS;
  const m=new Map();
  (DB.materiais||[]).forEach(x=>{const c=String(x.codigo||'').trim().toUpperCase();if(c&&x.desc&&x.desc!=='#N/A'&&!m.has(c))m.set(c,x.desc);});
  if(typeof BOM_PROJETO_CONFIRMADO!=='undefined')Object.values(BOM_PROJETO_CONFIRMADO).forEach(l=>l.forEach(p=>{const c=String(p.cod||'').trim().toUpperCase();if(c&&p.nome&&!m.has(c))m.set(c,p.nome);}));
  (DB.montagens||[]).forEach(x=>(x.bom||[]).forEach(b=>{const c=String(b.cod||'').trim().toUpperCase();if(c&&b.nome&&!m.has(c))m.set(c,b.nome);}));
  /* Por fim, o que vier dos desenhos normativos â€” sÃ³ para os cÃ³digos que continuam sem nome. */
  if(typeof NOMES_PECAS_DESENHOS!=='undefined')
    Object.entries(NOMES_PECAS_DESENHOS).forEach(([c,d])=>{if(!m.has(c))m.set(c,d);});
  _NOMES_PECAS=m;return m;
}
/* CÃ³digos de peÃ§a que aparecem nas listas de peÃ§as aplicadas aos postes deste projeto. */
function codigosUsadosNoProjeto(){
