        datasPorSap[sap].push({d:dt,q,dest:mv.dest||'',mvId:mv.id});
      }
    }
    if(cod){
      saidasTotalPorCodigo[cod]=(saidasTotalPorCodigo[cod]||0)+q;
      if(dt>=dataIni&&dt<=dataFim){
        saidasPorCodigo[cod]=(saidasPorCodigo[cod]||0)+q;
        if(!datasPorCodigo[cod]) datasPorCodigo[cod]=[];
        datasPorCodigo[cod].push({d:dt,q,dest:mv.dest||'',mvId:mv.id});
      }
    }
  }
  
  // Build resultados
  FC_RESULTADOS=[];
  let comSaidas=0, semMatch=0;
  for(let i=1;i<rows.length;i++){
    const r=rows[i];
    const sap=String(r[idxSap]||'').trim();
    if(!sap) continue;
    const desc=String(r[idxDesc]||'').trim();
    const un=idxUn>=0 ? String(r[idxUn]||'').trim() : '';
    const pep=idxPep>=0 ? String(r[idxPep]||'').trim() : '';
    const codInt=extractCodInterno(desc);
    let saidaPer=saidasPorSap[sap]||0;
    let saidaTotal=saidasTotalPorSap[sap]||0;
    let datas=datasPorSap[sap]||[];
    let metodo='SAP';
    if(saidaPer<=0 && codInt && saidasPorCodigo[codInt]){
      saidaPer=saidasPorCodigo[codInt];
      saidaTotal=saidasTotalPorCodigo[codInt];
      datas=datasPorCodigo[codInt]||[];
      metodo='CÃ³dInt';
    }
    if(saidaTotal<=0 && codInt && saidasTotalPorCodigo[codInt]){
      saidaTotal=saidasTotalPorCodigo[codInt];
      metodo='CÃ³dInt';
    }
    const matExists=DB.materiais.some(x=>(x.sap===sap||x.codigo_alt===sap||(codInt && (x.codigo||'').toUpperCase()===codInt)));
