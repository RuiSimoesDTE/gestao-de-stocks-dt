/* Resolve e agrega apenas listas de peÃ§as documentalmente disponÃ­veis. */
function dadosBOMProjeto(desenho,aplicacao){
  const d=String(desenho||'').trim();
  let a=String(aplicacao||'').trim();
  /* 17/09/2026 â€” E-6180 rev. B: nos cadernos a referÃªncia vem com a posiÃ§Ã£o de montagem
     ("TA-II", "CA-II"). A posiÃ§Ã£o (I, II, III) sÃ³ diz onde se fura; as peÃ§as sÃ£o as da
     montagem TA/CA/TRâ€¦, que Ã© o que o catÃ¡logo guarda. */
  if(d.toUpperCase()==='E-6180')a=a.replace(/-(?:I{1,3})$/i,'');
  if(!d||d==='â€”')return {bom:[],erro:'ReferÃªncia vazia'};
  const norm=s=>String(s||'').toUpperCase().replace(/\s+/g,' ').trim();
  const canon=s=>norm(s).replace(/^((?:EC|E|C|CP)-\d+[A-Z0-9]*)-(?=[A-Z0-9])/,'$1 ');
  const alvo=norm(d+(a?' '+a:'')),montagens=DB.montagens||[];
  /* Preferir sempre a montagem que tem peÃ§as: existem cÃ³pias repetidas que sÃ³
     diferem em maiÃºsculas ou num hÃ­fen, e algumas estÃ£o vazias. */
  const comAlvo=montagens.filter(x=>norm(x.codigo)===alvo);
  let m=comAlvo.find(x=>Array.isArray(x.bom)&&x.bom.length)||comAlvo[0];
  if(!m&&!a)m=montagens.find(x=>norm(x.codigo)===norm(d));
  if(!m){const eq=montagens.filter(x=>canon(x.codigo)===canon(alvo));m=eq.find(x=>Array.isArray(x.bom)&&x.bom.length)||eq[0];}
  /* 18/09/2026 (C11): retirado o atalho "comeÃ§a pelo desenho e acaba na aplicaÃ§Ã£o" â€” "IA" tambÃ©m
     Ã© o fim de "IIA" e trocava montagens em silÃªncio. O que nÃ£o se encontra vai para as pendÃªncias. */
  let sintetico=null;
  if(norm(d)==='C-160'&&/^S[A-Z0-9]/.test(norm(a))){
    let base=norm(a).slice(1);if(base==='CRAL')base='CRL';
    const mb=montagens.find(x=>norm(x.codigo)==='C-160 '+base);
    if(mb&&Array.isArray(mb.bom)&&mb.bom.length){
      const cer=x=>/ISOLADOR/i.test(String(x.nome||matById(x.mat)?.desc||''))&&!/SINT/i.test(String(x.nome||matById(x.mat)?.desc||''))&&norm(x.cod||matById(x.mat)?.codigo||'')!=='62';
      const qi=mb.bom.filter(cer).reduce((s,x)=>s+(Number(x.qtd)||0),0);let inserido=false;sintetico=[];
      mb.bom.forEach(x=>{if(cer(x)){if(!inserido&&qi>0){sintetico.push({cod:'62',nome:'Isolador sintÃ©tico de 11 t',qtd:qi,ref:'03.200.02'});inserido=true;}}else sintetico.push({...x});});
    }
  }
  const confirmado=typeof BOM_PROJETO_CONFIRMADO!=='undefined'&&BOM_PROJETO_CONFIRMADO[alvo];
  const bom=confirmado||sintetico||(m&&Array.isArray(m.bom)?m.bom:[]);
  if(!bom.length)return {bom:[],erro:!m?'Desenho/aplicaÃ§Ã£o nÃ£o localizado':'Lista de peÃ§as ainda nÃ£o transcrita e validada'};
  return {bom,fonte:m&&(/DESENHO CAIDE/i.test(String(m.desc||''))||m.caide_designacao)?'desenho antigo':'desenho validado'};
}
/* Metros de tubo de um poste, a partir das medidas do caderno de montagem.
