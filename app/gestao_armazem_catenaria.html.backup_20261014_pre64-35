        '<td><button class="btn cinza sm" onclick="mapaDescarregarGuardado(\''+esc(m.id)+'\')">â¬‡ Excel</button> <button class="btn cinza sm" onclick="mapaApagar(\''+esc(m.id)+'\')">Apagar</button></td></tr>').join('')+'</table></div>'
      :'<p class="mini">Ainda nÃ£o hÃ¡ mapas guardados. Envia os que jÃ¡ deste (maio, junho, julho, agosto, setembroâ€¦), para o programa saber o que jÃ¡ foi lanÃ§ado.</p>';
  }
  window.mapaDescarregarGuardado=function(id){const m=lista().find(x=>x.id===id);if(!m||!m.xlsx)return;baixar(m.nomeFicheiro||('mapa_'+m.etiqueta+'.xlsx'),Uint8Array.from(atob(m.xlsx),c=>c.charCodeAt(0)),'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet');};
  window.mapaApagar=function(id){if(!confirm('Apagar este mapa guardado? O programa passa a achar que esses consumos ainda nÃ£o foram lanÃ§ados.'))return;const i=lista().findIndex(x=>x.id===id);if(i>=0)lista().splice(i,1);guardar();desenharLista();};
  function baixar(nome,dados,tipo){const a=document.createElement('a');a.href=URL.createObjectURL(new Blob([dados],{type:tipo}));a.download=nome;document.body.appendChild(a);a.click();setTimeout(()=>{URL.revokeObjectURL(a.href);a.remove();},1500);}

  /* ---------- preparar o mapa novo ---------- */
  function consumoPorCodigo(sheetCodes,intIdx,lanc,ate){
    const out=new Map();const excl=/IC-0018/i;
    for(const m of DB.movimentos){
      if(!eConsumoReal(m)||excl.test(String(m.dest||'')))continue;
      if(ate&&String(m.data)>ate)continue;   // as saÃ­das depois da data da folha sÃ£o do mapa seguinte
      const f=matById(m.mat)||{};const s=String(f.sap||'').trim();
