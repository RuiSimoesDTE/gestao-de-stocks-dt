/* Comprimento de corte do tubo da consola.
   O desenho E-6182 (Consola isolada em tubo) dÃ¡ K3 ao tubo 30x38 (item 10) e K4 ao
   tubo 40x49 (item 11), sempre a partir do KL do caderno de montagem e descontando
   conforme o isolador do poste:
       ZT         K3 = KL - 472 mm     K4 = KL - 565 mm
       ZM         K3 = KL - 631 mm     K4 = KL - 724 mm
       sintÃ©tico  K3 = K4 = KL - 580 mm
   Consolas de outros desenhos nÃ£o tÃªm fÃ³rmula de corte documentada: fica o KL
   nominal e a diferenÃ§a Ã© assinalada nas pendÃªncias, para nÃ£o passar despercebida. */
function comprimentoConsola(c,p){
  if(c.KL==null)return {metros:null};
  const desenho=String(c.consTubo||'').toUpperCase(),dim=String(c.consTubo_dim||'').toLowerCase();
  const nominal=aviso=>({metros:c.KL,origem:'consola (KL nominal)',aviso:aviso});
  /* C-9058 rev. G (consola horizontal isolada em tubo): ZT K3 = KL-429, K4 = KL-517;
     ZM K3 = KL-588, K4 = KL-676; sintÃ©tico K3 = K4 = KL-538 mm. */
  if(/C-9058/.test(desenho)){
    const iso9=String(p.isolamento||'').toUpperCase(),k4=/40x49/.test(dim);
    const d9=/SINT/.test(iso9)?0.538:/ZM|MAR[ÃI]T/.test(iso9)?(k4?0.676:0.588):/ZT|TERRESTRE/.test(iso9)?(k4?0.517:0.429):null;
    if(d9==null&&!iso9)return {metros:Math.round((c.KL-(k4?0.517:0.429))*1000)/1000,origem:'consola C-9058 (isolamento nÃ£o registado: ZT)'};
    if(d9==null)return nominal('consola C-9058 â€” isolador nÃ£o identificado ("'+(p.isolamento||'vazio')+'"); contabilizado o KL nominal');
    return {metros:Math.round((c.KL-d9)*1000)/1000,origem:'consola C-9058 ('+(k4?'K4':'K3')+' = KL-'+Math.round(d9*1000)+' mm)'};
  }
  if(!/E-6182/.test(desenho))
    return nominal('consola '+(c.consTubo||'â€”')+' â€” sem fÃ³rmula de corte documentada; contabilizado o KL nominal de '+fmt(c.KL)+' m');
  const iso=String(p.isolamento||'').toUpperCase(),k4=/40x49/.test(dim);
  let desconto;
  if(/SINT/.test(iso))desconto=0.58;
  else if(/ZM|MAR[ÃI]T/.test(iso))desconto=k4?0.724:0.631;
  else if(/ZT|TERRESTRE/.test(iso))desconto=k4?0.565:0.472;
  else if(!iso){desconto=k4?0.565:0.472;   // 18/09/2026 (C15): sem isolamento registado â†’ ZT (a obra Ã© toda ZT, regra de 28/08/2026)
    return {metros:Math.round((c.KL-desconto)*1000)/1000,origem:'consola ('+(k4?'K4':'K3')+' = KL-'+Math.round(desconto*1000)+' mm; isolamento nÃ£o registado: ZT)'};}
  else return nominal('consola E-6182 â€” isolador nÃ£o identificado ("'+(p.isolamento||'vazio')+'"); contabilizado o KL nominal');
  return {metros:Math.round((c.KL-desconto)*1000)/1000,origem:'consola ('+(k4?'K4':'K3')+' = KL-'+Math.round(desconto*1000)+' mm)'};
}
function metrosTubosPoste(p){
  const res=new Map(),faltas=[],pendulos=[];
  const matDaDim=dim=>{const d=String(dim||'').trim().toLowerCase();if(!d)return null;
    return (DB.materiais||[]).find(x=>/tubo de a[Ã§c]o/i.test(x.desc||'')&&String(x.desc).toLowerCase().includes('['+d+']'))||null;};
  const juntar=(dim,metros,origem)=>{
    if(metros==null||!(Number(metros)>0))return;
    const m=matDaDim(dim);
    if(!m){faltas.push(origem+' â€” '+(dim?'tubo '+dim+' sem cÃ³digo no catÃ¡logo':'dimensÃ£o do tubo nÃ£o documentada')+': '+fmt(Number(metros))+' m nÃ£o contabilizados');return;}
    const cod=String(m.codigo).toUpperCase();
    const z=res.get(cod)||{metros:0,nome:m.desc,fontes:new Set()};
    z.metros=Math.round((z.metros+Number(metros))*100)/100;z.fontes.add(origem);res.set(cod,z);
  };
  const cons=p.consolas&&Object.keys(p.consolas).length?p.consolas:{};
  Object.values(cons).forEach(c=>{
    if(c.tirTubo)juntar(c.tirTubo_dim,c.TT,'tirante (TT)');
    if(c.consTubo){
      /* Desenho E-6181 (Tirante isolado para consola), montagens Tc, Mc e Sc: tÃªm um
         Ãºnico tubo â€” o item 17, tubo de aÃ§o 19x26, medido pela cota TT. Nestes postes o
         caderno repete o mesmo elemento nos campos do tirante e da consola (TL=KL, TT=K).
         ContÃ¡-lo outra vez como tubo da consola seria comprar a dobrar. */
      const mesmoDesenho=String(c.consTubo||'').trim().toUpperCase()===String(c.tirTubo||'').trim().toUpperCase();
      if(/E-6181/i.test(String(c.consTubo||''))&&mesmoDesenho){
        /* jÃ¡ contado acima pelo tirante (TT) */
      }else{
        const r=comprimentoConsola(c,p);juntar(c.consTubo_dim,r.metros,r.origem);if(r.aviso)faltas.push(r.aviso);
      }
    }
    /* BraÃ§o de apoio para consola (C-3511). O desenho nÃ£o tem tubo prÃ³prio: remete para o
       "Tirante isolado da consola em tubo" do E-6181, montagens Tc, Mc ou Sc â€” tubo de aÃ§o
       19x26 (Cod. 10A), medido pela cota TT. No caderno o braÃ§o traz bracoL e bracoS, e a
       diferenÃ§a entre os dois dÃ¡ 850/860 mm, a mesma de TL-TT nas consolas: logo bracoS Ã© o
       equivalente ao TT e Ã© essa a medida de corte do tubo. */
    if(c.bracoApoio&&c.bracoS!=null)juntar('19x26',c.bracoS,'braÃ§o de apoio '+(c.bracoApoio||'C-3511')+' (S)');
    else if(c.bracoApoio&&c.bracoL!=null)faltas.push('braÃ§o de apoio '+(c.bracoApoio||'')+' â€” sem a cota S no caderno: '+fmt(Number(c.bracoL))+' m nÃ£o contabilizados');
    (c.antibalancantes||[]).forEach(a=>{
      if(a.L==null)return;
      /* E-6213 â€” FixaÃ§Ã£o rÃ­gida do antibalanÃ§ante. O desenho dÃ¡ l = L - 50 mm e o
         Ãºnico tubo da tabela de peÃ§as Ã© o Cod. 10E (30x38), igual nas montagens I a IV.
         O L vem do caderno de montagem, na prÃ³pria linha do E-6213. */
      if(/E-?6213/i.test(String(a.ref||''))){juntar('30x38',Math.round((Number(a.L)-0.05)*1000)/1000,'fixaÃ§Ã£o '+(a.ref||'E-6213')+' (l = L-50 mm)');return;}
      /* E-6188 â€” PÃªndulo para antibalanÃ§ante. NÃ£o leva tubo nenhum: a tabela de peÃ§as
         tem cabo Bz 10 mm (Cod. 9C) em qb, mais braÃ§adeiras. NÃ£o Ã© material de tubo. */
      if(/E-?6188/i.test(String(a.ref||''))){pendulos.push({ref:a.ref,L:Number(a.L)||0});return;}
      /* EC-234 rev. A (antibalanÃ§ante isolado): montagens Ta, Ma e Sa levam tubo 24x32 (cÃ³d. 10C);
         Tb, Mb e Sb levam 34x42 (cÃ³d. 10F). O tubo sai do desenho, nÃ£o do texto do caderno. */
      const m234=String(a.ref||'').match(/EC-?234\s*([TMS])([AB])\b/i);
      if(m234){juntar(m234[2].toUpperCase()==='A'?'24x32':'34x42',a.L,'antibalanÃ§ante '+a.ref+' (L)');return;}
      /* E-6185 â€” AntibalanÃ§ante direto e sobrelevado. O caderno regista o tipo como
         'FC SOBREELEVADO', que nÃ£o Ã© medida. O desenho diz o tubo de cada montagem:
         montagens A e B levam tubo 19x26; a montagem C leva 24x32; l = variÃ¡vel. */
      const m6185=String(a.ref||'').match(/E-?6185\s*([ABC])\b/i);
      if(m6185&&!/^\d+x\d+$/.test(String(a.tipo||'').trim())){
        juntar(m6185[1].toUpperCase()==='C'?'24x32':'19x26',a.L,'antibalanÃ§ante sobrelevado '+a.ref+' (L)');return;
      }
      juntar(a.tipo,a.L,'antibalanÃ§ante (L)');
    });
  });
  return {tubos:res,faltas,pendulos};
}
