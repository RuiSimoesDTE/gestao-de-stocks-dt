/* Stock por material/armazÃ©m â€” Ã­ndice em cache, reconstruÃ­do quando os dados mudam */
let _stk=null;
function rebuildStock(){
  _stk={};
  for(const m of DB.materiais)_stk[m.id]={__t:0};
  for(const mv of DB.movimentos){
    const e=_stk[mv.mat];if(!e)continue;
    const q=mv.qtd||0;
    if(mv.tipo==='entrada'){e[mv.arm]=(e[mv.arm]||0)+q;e.__t+=q;}
    else if(mv.tipo==='saida'){e[mv.arm]=(e[mv.arm]||0)-q;e.__t-=q;}
    else if(mv.tipo==='transferencia'){
      e[mv.arm]=(e[mv.arm]||0)-q;
      if(mv.armDst)e[mv.armDst]=(e[mv.armDst]||0)+q;
      else if(mv.obraDst)e.__t-=q;
    }
  }
}
function stockMaterial(matId,arm){
  if(!_stk)rebuildStock();
  const e=_stk[matId];if(!e)return 0;
  const v=arm?(e[arm]||0):e.__t;
  return Math.round(v*1000)/1000;
}
function stockTotal(matId){return stockMaterial(matId,null);}

