function _calcRelatorio(){
  const de=document.getElementById('rel-de').value;
  const ate=document.getElementById('rel-ate').value;
  const arm=document.getElementById('rel-arm').value;
  const forn=document.getElementById('rel-forn').value;
  if(!de||!ate){return null;}
  const inRange=mv=>(!de||mv.data>=de)&&(!ate||mv.data<=ate)&&(!arm||mv.arm===arm||mv.armDst===arm);
  const fornOK=mv=>{if(!forn)return true;const o=(mv.origem||'').trim();if(o)return o===forn;const m=matById(mv.mat);return m&&(m.fornecedor||'')===forn;};
  const ents=DB.movimentos.filter(mv=>mv.tipo==='entrada'&&inRange(mv)&&fornOK(mv));
  const sais=DB.movimentos.filter(mv=>eConsumoReal(mv)&&inRange(mv)&&fornOK(mv));
  const trfs=DB.movimentos.filter(mv=>mv.tipo==='transferencia'&&inRange(mv)&&fornOK(mv));
  // resumo por material
  const porMat={};
  [...ents,...sais].forEach(mv=>{
    const m=matById(mv.mat);if(!m)return;
    const r=porMat[m.id]=porMat[m.id]||{m,ent:0,sai:0};
    if(mv.tipo==='entrada')r.ent+=mv.qtd||0; else r.sai+=mv.qtd||0;
  });
  return {de,ate,arm,forn,ents,sais,trfs,porMat};
}
