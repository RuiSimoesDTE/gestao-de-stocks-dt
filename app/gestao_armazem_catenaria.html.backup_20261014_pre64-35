  const ler=f=>new Promise((ok,ko)=>{const r=new FileReader();r.onload=()=>ok(r.result);r.onerror=()=>ko(r.error);r.readAsArrayBuffer(f);});
  const lerB64=f=>new Promise((ok,ko)=>{const r=new FileReader();r.onload=()=>ok(String(r.result).split(',')[1]||'');r.onerror=()=>ko(r.error);r.readAsDataURL(f);});
  function dataDoNome(n){const m=String(n).match(/(\d{2})_(\d{2})_(\d{4})/);return m?m[3]+'-'+m[2]+'-'+m[1]:'';}
  function etiquetaDoNome(n){const m=String(n).match(/(\d{2}_\d{2}_\d{4})/);return m?m[1]:String(n).replace(/\.xlsx$/i,'');}

  /* ---------- mapas dados ---------- */
