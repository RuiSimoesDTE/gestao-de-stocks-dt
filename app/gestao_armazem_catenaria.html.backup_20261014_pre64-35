        lista().push({id:'mapa-'+etq,etiqueta:etq,data:dataDoNome(f.name),nomeFicheiro:f.name,guardadoEm:new Date().toISOString(),por:user(),
          linhas:com.map(l=>({sap:l.sap,int:l.int,txt:l.txt,consumo:l.consumo})),total:R3(com.reduce((a,l)=>a+l.consumo,0)),descricao:'Mapa enviado jÃ¡ preenchido e lanÃ§ado.',xlsx:await lerB64(f)});
        n++;
      }catch(e){console.error(e);toast('NÃ£o consegui ler "'+f.name+'": '+e.message,'erro');}
    }
    lista().sort((a,b)=>String(a.data||a.etiqueta).localeCompare(String(b.data||b.etiqueta)));
    $('mapa-dado-file').value='';guardar();desenharLista();if(n)toast(n+' mapa(s) guardado(s)','ok');
  };
  function desenharLista(){
