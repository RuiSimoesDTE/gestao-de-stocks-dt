    const col=(nomes,def)=>{for(const n of nomes){const i=cab.findIndex(h=>h===n);if(i>=0)return i;}return def;};
    const C={sap:col(['material'],0),txt:col(['texto breve material'],1),pep:col(['elemento pep'],5),stock:col(['estoque total'],6),un:col(['un','um bÃ¡sica'],7),valor:col(['valor total'],8),consumo:col(['consumo'],9)};
    const linhas=[];
    for(let i=1;i<rows.length;i++){const r=rows[i];const sap=String(r[C.sap]==null?'':r[C.sap]).trim();if(!sap)continue;
      linhas.push({row:i+1,sap,txt:String(r[C.txt]||''),int:codInt(r[C.txt]),pep:String(r[C.pep]||''),stock:Number(r[C.stock])||0,un:String(r[C.un]||''),valor:Number(r[C.valor])||0,consumo:typeof r[C.consumo]==='number'?r[C.consumo]:0});}
