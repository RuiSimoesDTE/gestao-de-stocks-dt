function motivoNaoConsumo(mv){
  if(!mv||mv.tipo!=='saida')return 'nÃ£o Ã© saÃ­da';
  if(/^gt2979-transferencia-/.test(String(mv.id||''))||mv.consumo===true)return '';
  if(mv.ajuste===true||mv.ficticia===true)return 'ajuste';
  if(mv.transferenciaObra===true)return 'transferÃªncia entre obras';
  if(mv.emprestimo===true)return 'emprÃ©stimo';
  const t=(String(mv.dest||'')+' '+String(mv.origem||'')+' '+String(mv.obs||'')).toLowerCase();
  if(/\broubo\b|assalto/.test(t))return 'roubo';
