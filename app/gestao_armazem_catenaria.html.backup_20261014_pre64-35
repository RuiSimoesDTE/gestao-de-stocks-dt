function agregarMateriaisProjeto(postes){
  const total=new Map(),pend=[];
  (postes||[]).forEach(p=>{
    const dados=dadosResumoPecasPoste(p);
    dados.pecas.forEach(x=>{
      const chave=(x.chave?x.chave:[x.cod,x.novo].join('|'))+'|'+(x.un||'');   // 18/09/2026 (C3/C12): peÃ§as sem cÃ³digo e espias separadas
      const z=total.get(chave)||{cod:x.cod,antigo:x.antigo,novo:x.novo,nome:x.nome,un:x.un||'',qtd:0,variavel:false,postes:new Set(),fontes:new Set(),antiga:false};
      z.qtd+=Number(x.qtd)||0;
      z.variavel=z.variavel||!!x.variavel;
      z.postes.add(p.codigo);
      (x.fontes||[]).forEach(f=>z.fontes.add(f));
      z.antiga=z.antiga||!!x.antiga;
      total.set(chave,z);
    });
    dados.pend.forEach(msg=>pend.push('Poste '+p.codigo+': '+msg));
  });
  return {
    pecas:[...total.values()].sort((a,b)=>String(a.cod).localeCompare(String(b.cod),'pt',{numeric:true})),
    pend
  };
}
