<script>
/* ================= MAPA MENSAL AUTOMÃTICO (07/10/2026) =================
   Guarda os mapas jÃ¡ dados (Excel com a coluna Consumo preenchida) e, ao receber a folha nova do SAP em branco, calcula o consumo de
   cada linha e devolve o Excel preenchido, com a descriÃ§Ã£o do que foi feito.
   Regra (a mesma usada Ã  mÃ£o em 30/09/2026): consumo real do programa (sem ajustes, transferÃªncias, roubos, emprÃ©stimos nem IC-0018)
   MENOS o jÃ¡ lanÃ§ado nos mapas guardados, LIMITADO ao stock SAP de cada linha. Linhas grandes ou duvidosas ficam por marcar. */
(function(){
  'use strict';
  const $=id=>document.getElementById(id);
  const esc=s=>escapeHtml(s);
  let _prep=null;      // mapa em preparaÃ§Ã£o
  const R3=x=>Math.round(x*1000)/1000;
  const norm=s=>String(s||'').trim().toUpperCase().replace(/\s+/g,'');
  const codInt=t=>{const m=String(t||'').match(/^([0-9]{1,4}[A-Z]{0,2}[0-9]{0,3})\s*-/);return m?m[1].toUpperCase():'';};
