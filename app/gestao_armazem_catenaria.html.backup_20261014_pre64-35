/* 18/09/2026 (A3/A4): as linhas "qb" nÃ£o tÃªm quantidade (dava NaN e o tubo nÃ£o saÃ­a do stock);
   as linhas sem ficha criavam movimentos sem material; a mesma peÃ§a em duas linhas escapava Ã 
   verificaÃ§Ã£o de stock. Agora: soma-se por material, e as linhas qb / sem ficha / a 0 ficam Ã  parte. */
function expandirBom(montId,n){
  const mo=montById(montId);const res=[];res.qb=[];res.semFicha=[];res.zero=[];
  if(!mo)return res;
  const porMat=new Map();
  (mo.bom||[]).forEach(b=>{
    const nome=b.nome||(matById(b.mat)||{}).desc||b.cod||'?';
    if(!b.mat||!matById(b.mat)){res.semFicha.push((b.cod?b.cod+' â€” ':'')+nome);return;}
    if(b.qtd==null||b.qtdTexto){if(!res.qb.some(x=>x.mat===b.mat))res.qb.push({mat:b.mat,nome});return;}
    const q=Number(b.qtd)*n;
    if(!(q>0)){res.zero.push((b.cod?b.cod+' â€” ':'')+nome);return;}
    porMat.set(b.mat,Math.round(((porMat.get(b.mat)||0)+q)*1000)/1000);
  });
  porMat.forEach((qtd,mat)=>res.push({mat,qtd}));
  return res;
}
