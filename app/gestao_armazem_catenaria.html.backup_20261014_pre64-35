      tbody.appendChild(tr);
    }
  } else {
    document.getElementById('fc-marcadas-card').style.display='none';
  }
  
  // Build mapas SAÃDAS por SAP e por cÃ³digo interno (excluindo marcadas para OUTRAS folhas)
  const saidasPorSap={}, saidasPorCodigo={};
  const saidasTotalPorSap={}, saidasTotalPorCodigo={};
  const datasPorSap={}, datasPorCodigo={};
  const naoConsumo={};let nNaoConsumo=0;
  for(const mv of DB.movimentos){
    if(mv.tipo!=='saida') continue;
    const folhaTag=mv.folha||'';
    if(folhaTag && folhaTag!==etiqueta) continue;  // skip se marcada para outra folha
    const mot=motivoNaoConsumo(mv);
    if(mot){const dt0=mv.data||'';if(dt0>=dataIni&&dt0<=dataFim){naoConsumo[mot]=(naoConsumo[mot]||0)+1;nNaoConsumo++;}continue;}   // 18/09/2026 (B3)
    const m=DB.materiais.find(x=>x.id===mv.mat);
    if(!m) continue;
    const sap=m.sap||m.codigo_alt||'';
    const cod=(m.codigo||'').toUpperCase();
    const dt=mv.data||'';
    const q=mv.qtd||0;
    if(sap){
      saidasTotalPorSap[sap]=(saidasTotalPorSap[sap]||0)+q;
      if(dt>=dataIni&&dt<=dataFim){
        saidasPorSap[sap]=(saidasPorSap[sap]||0)+q;
