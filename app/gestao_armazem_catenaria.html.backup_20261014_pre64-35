<style>
  :root{
    --azul:#0b4f8a; --azul-esc:#08365e; --azul-claro:#e8f1f9;
    --verde:#1b8a4b; --verde-claro:#e6f5ec;
    --vermelho:#c0392b; --vermelho-claro:#fbeae8;
    --laranja:#d97c0a; --laranja-claro:#fdf1e2;
    --cinza:#5b6b7a; --cinza-claro:#f4f6f8; --borda:#d9e0e7;
    --texto:#1f2d3a; --branco:#fff;
  }
  *{box-sizing:border-box;margin:0;padding:0;}
  body{font-family:'Segoe UI',Roboto,Helvetica,Arial,sans-serif;background:#eef1f4;color:var(--texto);font-size:14px;}
  header{background:var(--azul);color:#fff;padding:14px 22px;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:10px;}
  header h1{font-size:18px;font-weight:600;display:flex;align-items:center;gap:12px;}
  header .logos{display:flex;align-items:center;gap:10px;background:#fff;padding:6px 10px;border-radius:8px;}
  header .logo-dte{height:36px;width:auto;display:block;}
  header .logo-dst{height:36px;width:36px;display:block;}
  header .sub{font-size:11px;opacity:.8;font-weight:400;display:block;}
  header .hdr-actions{display:flex;gap:8px;flex-wrap:wrap;}
  .obra-tabs-bar{background:#dfe7ee;border-bottom:1px solid #c3ced8;padding:10px 14px 0;display:flex;align-items:flex-end;gap:10px;overflow-x:auto;}
  .obra-tabs-label{font-size:10px;font-weight:800;letter-spacing:.8px;color:var(--cinza);padding:0 2px 11px;white-space:nowrap;}
  #obra-tabs{display:flex;align-items:flex-end;gap:5px;min-width:max-content;}
  .obra-tab{display:flex;align-items:center;gap:6px;border:1px solid rgba(255,255,255,.16);background:rgba(255,255,255,.06);color:#d5e6f5;padding:8px 10px;border-radius:9px;cursor:pointer;font-size:12.5px;font-weight:650;text-align:left;}
  .obra-tab:hover{background:rgba(255,255,255,.14);color:#fff;}
  .obra-tab.active{background:#1c6fb8;border-color:#3f93de;color:#fff;}
  .obra-tab .obra-codigo{font-size:10px;font-weight:400;opacity:.75;margin-left:6px;}
  .obra-tab-nova{width:100%;margin-top:5px;border:1px dashed rgba(255,255,255,.35);background:transparent;color:#bcd8f2;padding:7px 10px;border-radius:9px;cursor:pointer;font-size:12px;font-weight:700;}
  .obra-tab-nova:hover{background:rgba(255,255,255,.08);color:#fff;}
  /* 23/09/2026 â€” menu na lateral esquerda (pedido do Rui). */
  .app{display:flex;align-items:stretch;min-height:calc(100vh - 66px);}
  #nav{background:linear-gradient(180deg,var(--azul-esc) 0%,#06294a 100%);width:248px;flex:0 0 248px;display:flex;flex-direction:column;gap:2px;padding:10px 10px 18px;position:sticky;top:0;align-self:flex-start;max-height:100vh;overflow-y:auto;transition:flex-basis .18s ease,width .18s ease;}
  #nav>*{flex:0 0 auto;}   /* sem isto, o conteÃºdo mais alto que o ecrÃ£ era espremido e os tÃ­tulos ficavam cortados */
  #nav::-webkit-scrollbar{width:8px}#nav::-webkit-scrollbar-thumb{background:rgba(255,255,255,.18);border-radius:8px}
  .sb-top{display:flex;align-items:center;gap:8px;padding:4px 4px 10px;}
  .sb-toggle{background:rgba(255,255,255,.08);border:0;color:#fff;width:34px;height:34px;border-radius:9px;cursor:pointer;font-size:15px;flex:0 0 34px;}
  .sb-toggle:hover{background:rgba(255,255,255,.18);}
  .sb-marca{color:#eaf4ff;font-weight:700;font-size:13px;letter-spacing:.3px;white-space:nowrap;overflow:hidden;}
  .sb-obras{padding:6px 4px 10px;border-bottom:1px solid rgba(255,255,255,.12);margin-bottom:8px;}
  .sb-lbl{display:block;font-size:10px;line-height:18px;font-weight:800;letter-spacing:1px;color:#8fb6d8;margin:0 0 6px 6px;text-transform:uppercase;}
  #obra-tabs{display:flex;flex-direction:column;gap:4px;}
  .sb-grupo-toggle{display:flex;align-items:center;justify-content:space-between;width:100%;background:none;border:0;color:#8fb6d8;margin:10px 0 2px;padding:7px 8px 6px;font-size:10px;line-height:18px;font-weight:800;letter-spacing:1px;text-transform:uppercase;white-space:nowrap;cursor:pointer;border-radius:8px;text-align:left;}
  .sb-grupo-toggle:hover{background:rgba(255,255,255,.08);color:#dceeff;}
  .sb-grupo-toggle .sb-seta{font-size:12px;line-height:1;transition:transform .18s ease;}
  .sb-grupo-toggle[aria-expanded="true"] .sb-seta{transform:rotate(90deg);}
  .sb-grupo-conteudo{display:none;flex-direction:column;gap:2px;}
  .sb-grupo-conteudo.aberto{display:flex;}
  #nav button[data-v]{display:flex;align-items:center;gap:10px;width:100%;background:none;border:0;color:#d5e6f5;padding:9px 10px;border-radius:9px;cursor:pointer;font-size:13.5px;font-weight:550;text-align:left;border-left:3px solid transparent;white-space:nowrap;overflow:hidden;}
  #nav button[data-v]:hover{background:rgba(255,255,255,.09);color:#fff;}
  #nav button[data-v].active{background:rgba(90,176,255,.20);color:#fff;border-left-color:#5ab0ff;font-weight:700;}
  #nav button[data-v] .ic{flex:0 0 20px;text-align:center;font-size:15px;filter:grayscale(.15);}
  #nav.sb-fechada{flex-basis:64px;width:64px;}
  #nav.sb-fechada .sb-marca,#nav.sb-fechada .sb-lbl,#nav.sb-fechada .sb-grupo-toggle,#nav.sb-fechada .tx,#nav.sb-fechada .sb-obras .obra-tab-nova{display:none;}
  #nav.sb-fechada .sb-grupo-conteudo{display:flex;}   /* menu sÃ³ com Ã­cones: mostra todos, estejam os grupos abertos ou nÃ£o */
  #nav.sb-fechada .sb-obras{padding-bottom:6px;}
  #nav.sb-fechada button[data-v]{justify-content:center;padding:10px 4px;}
  #nav.sb-fechada .obra-tab{justify-content:center;padding:8px 4px;font-size:11px;}
  #nav.sb-fechada .obra-tab .obra-codigo{display:none;}
  [hidden]{display:none!important;}   /* PWA: botÃµes escondidos com o atributo hidden */
  .pill-rede{background:#c0392b;color:#fff;border-radius:999px;padding:4px 11px;font-size:12px;font-weight:700;align-self:center;white-space:nowrap;}
  /* ---- Pedidos ao armazÃ©m (07/10/2026) ---- */
  .ped-badge{display:inline-block;margin-left:6px;background:#ffb020;color:#1a1a1a;border-radius:999px;padding:0 7px;font-size:11px;font-weight:800;line-height:18px;min-width:18px;text-align:center;}
  .ped-badge[hidden]{display:none!important;}
  .ped-tag{display:inline-block;border-radius:999px;padding:2px 10px;font-size:12px;font-weight:700;white-space:nowrap;}
  .ped-e-pedido{background:#fff3cd;color:#7a5b00;}.ped-e-prep{background:#e0ecff;color:#1b4a8f;}.ped-e-env{background:#e6e0ff;color:#4a2f9f;}
  .ped-e-parc{background:#ffe3cf;color:#8a3b00;}.ped-e-rec{background:#d9f3e1;color:#116b34;}.ped-e-canc{background:#e5e7eb;color:#555;text-decoration:line-through;}
  .ped-urg{display:inline-block;background:#c0392b;color:#fff;border-radius:6px;padding:0 6px;font-size:10.5px;font-weight:800;letter-spacing:.3px;vertical-align:middle;}
  .ped-linha{cursor:pointer;}.ped-linha:hover td{background:#eef5ff;}
  .ped-cab{display:grid;grid-template-columns:repeat(auto-fit,minmax(190px,1fr));gap:8px 18px;margin:12px 0;padding:10px 12px;background:#f5f8fb;border-radius:8px;}
  .ped-cab span{display:block;font-size:11px;color:#6b7785;text-transform:uppercase;letter-spacing:.4px;}.ped-cab b{font-size:14px;}
  .ped-acoes{display:flex;gap:9px;flex-wrap:wrap;margin:12px 0;}
  #modal-pedido-ver .modal{max-width:980px;}#modal-pedido .modal{max-width:920px;}
  #folha-pedido{display:none;}
  @media print{
    body.imprimir-pedido>*:not(#folha-pedido){display:none!important;}
    body.imprimir-pedido #folha-pedido{display:block!important;position:static;padding:0;color:#000;font-family:Arial,Helvetica,sans-serif;font-size:12.5px;}
    .fp-topo{display:flex;align-items:center;gap:16px;border-bottom:3px solid #0b4f8a;padding-bottom:10px;margin-bottom:12px;}
    .fp-topo img{height:54px;}.fp-titulo{font-size:21px;font-weight:800;color:#0b4f8a;}.fp-sub{font-size:12px;color:#444;}.fp-num{margin-left:auto;font-size:20px;font-weight:800;border:2px solid #0b4f8a;border-radius:8px;padding:6px 12px;}
    .fp-cab,.fp-lin{width:100%;border-collapse:collapse;margin-bottom:14px;}.fp-cab td{border:1px solid #999;padding:5px 8px;}
    .fp-lin th{background:#0b4f8a;color:#fff;padding:6px;text-align:left;}.fp-lin td{border:1px solid #999;padding:6px;height:22px;}
    .fp-ass{display:flex;justify-content:space-between;gap:20px;margin-top:34px;font-size:12px;}
  }
  /* ---- Etiquetas QR e baixa (07/10/2026) ---- */
  #folha-etiquetas{display:none;}
  #modal-baixa .modal{max-width:520px;}
  #baixa-qtd{font-size:26px;font-weight:700;text-align:center;}
  #modal-baixa .btn.grande{width:100%;font-size:18px;padding:14px;margin-top:10px;}
  #modal-camara .modal{max-width:520px;text-align:center;}#etq-video{width:100%;max-height:60vh;border-radius:10px;background:#000;}
  /* modo operador (telemÃ³vel): sÃ³ a leitura do QR e a baixa */
  #op-barra{display:none;}
  body.modo-operador{background:#eef1f4;}
  body.modo-operador>*{display:none!important;}
  body.modo-operador>#op-barra{display:block!important;}
  body.modo-operador>#login-bloqueio[style*="flex"]{display:flex!important;}
  body.modo-operador>#modal-baixa.show,body.modo-operador>#modal-camara.show{display:flex!important;}
  body.modo-operador>#toast{display:block!important;}
  body.modo-operador>#op-zoom.show{display:flex!important;}
  #op-zoom.show{display:flex!important;}
  body.modo-operador #modal-baixa .btn.cinza[onclick*="fecharBaixa"]{display:none;}
  #op-barra{max-width:460px;margin:0 auto;padding:18px 16px;font-family:inherit;}
  #op-barra .op-topo{display:flex;align-items:center;gap:12px;margin-bottom:14px;}#op-barra img{height:40px;}
  #op-barra h1{font-size:19px;margin:0;color:#0b4f8a;}#op-barra .op-user{font-size:12.5px;color:#556;}
  #op-barra .btn{width:100%;font-size:19px;padding:16px;margin-bottom:12px;}
  #op-barra input{width:100%;box-sizing:border-box;font-size:17px;padding:12px;margin-bottom:8px;}
  #op-msg{min-height:26px;margin:10px 0;font-weight:700;font-size:16px;}
  #op-res .op-item{background:#fff;border:1px solid #d5dde6;border-radius:10px;padding:11px 12px;margin-bottom:6px;font-size:15px;display:flex;justify-content:space-between;gap:10px;align-items:center;cursor:pointer;}
  #op-res .op-stk{white-space:nowrap;font-weight:800;color:#116b34;background:#e3f6ea;border-radius:8px;padding:3px 8px;font-size:13px;}#op-res .op-stk.zero{color:#a02318;background:#fbe3e0;}
  @media print{
    body.imprimir-etiquetas>*:not(#folha-etiquetas){display:none!important;}
    body.imprimir-etiquetas #folha-etiquetas{display:grid!important;grid-template-columns:repeat(3,63mm);grid-auto-rows:38mm;gap:0;position:static;padding:0;margin:0;color:#000;font-family:Arial,Helvetica,sans-serif;}
    .etq{width:63mm;height:38mm;box-sizing:border-box;border:.2mm dashed #bbb;padding:2.5mm;display:flex;gap:2.5mm;align-items:center;overflow:hidden;page-break-inside:avoid;break-inside:avoid;}
    .etq-qr{flex:0 0 29mm;width:29mm;height:29mm;}.etq-qr svg{display:block;width:100%;height:100%;}
    .etq-tx{flex:1;min-width:0;}.etq-cod{font-size:13pt;font-weight:800;line-height:1.05;word-break:break-all;}
    .etq-desc{font-size:7.2pt;line-height:1.15;margin-top:1mm;max-height:15mm;overflow:hidden;}.etq-peq{font-size:6pt;color:#444;margin-top:1mm;word-break:break-all;}
  }
  /* ---- Login, sessÃ£o e pasta partilhada (07/10/2026) ---- */
  .pill-sinc{align-self:center;border-radius:999px;padding:4px 11px;font-size:12px;font-weight:700;white-space:nowrap;cursor:pointer;background:#e5e7eb;color:#333;border:0;}
  .pill-sinc.ok{background:#d9f3e1;color:#116b34;}.pill-sinc.aviso{background:#ffe3b3;color:#8a4b00;}.pill-sinc.erro{background:#f8d0cc;color:#a02318;}
  .pill-sessao{align-self:center;font-size:12.5px;font-weight:600;white-space:nowrap;}
  #login-bloqueio{position:fixed;inset:0;z-index:20000;background:linear-gradient(160deg,#0b4f8a,#0a2f55);align-items:center;justify-content:center;padding:16px;overflow:auto;}
  .login-caixa{background:#fff;border-radius:14px;width:100%;max-width:400px;padding:26px 24px;box-shadow:0 20px 60px rgba(0,0,0,.45);}
  .login-caixa h2{margin:6px 0 14px;font-size:18px;color:#0b4f8a;text-align:center;}.login-logo{display:block;margin:0 auto;height:56px;}
  .login-caixa label{display:block;font-size:12px;color:#556;margin:10px 0 3px;font-weight:600;}.login-caixa input{width:100%;box-sizing:border-box;font-size:16px;padding:10px;}
  .login-tabs{display:flex;gap:6px;margin-bottom:6px;}.login-tabs button{flex:1;border:0;border-bottom:3px solid #dde3ea;background:none;padding:9px;font-weight:700;cursor:pointer;color:#667;}.login-tabs button.on{border-bottom-color:#0b4f8a;color:#0b4f8a;}
  .login-caixa .btn.grande{width:100%;margin-top:14px;padding:12px;font-size:16px;}
  .sb-backdrop{display:none;position:fixed;inset:0;background:rgba(6,20,35,.45);z-index:480;}
  .sb-menu-btn{display:none;background:rgba(255,255,255,.12);border:0;color:#fff;width:38px;height:38px;border-radius:10px;font-size:17px;cursor:pointer;}
  @media(max-width:900px){
    .app{display:block;}
    #nav{position:fixed;z-index:500;top:0;left:0;height:100vh;max-height:100vh;transform:translateX(-100%);transition:transform .2s ease;}
    #nav.sb-aberta{transform:none;box-shadow:0 0 30px rgba(0,0,0,.35);}
    #nav.sb-fechada{flex-basis:248px;width:248px;}
    #nav.sb-fechada .sb-marca,#nav.sb-fechada .sb-lbl,#nav.sb-fechada .sb-grupo-toggle,#nav.sb-fechada .tx{display:revert;}
    #nav.sb-fechada .sb-grupo-conteudo{display:none;}#nav.sb-fechada .sb-grupo-conteudo.aberto{display:flex;}
    #nav.sb-fechada button[data-v]{justify-content:flex-start;padding:9px 10px;}
    .sb-backdrop.on{display:block;}
    .sb-menu-btn{display:inline-block;}
    .sb-toggle{display:none;}
  }
  nav button{background:none;border:none;color:#cfe0ee;padding:12px 16px;cursor:pointer;font-size:13px;font-weight:500;border-bottom:3px solid transparent;}
  nav button:hover{color:#fff;background:rgba(255,255,255,.06);}
  nav button.active{color:#fff;border-bottom-color:#5ab0ff;}
  .nav-areas{display:flex;gap:4px;width:100%;border-bottom:1px solid rgba(255,255,255,.14);}
  .nav-area{font-size:14px!important;font-weight:750!important;padding:13px 22px!important;}
  .nav-sub{display:none;flex-wrap:wrap;width:100%;align-items:stretch;}
  .nav-sub.active{display:flex;}
  .nav-more{position:relative;margin-left:auto;display:flex;align-items:stretch;}
  .nav-more-toggle{font-weight:700!important;color:#fff!important;border-left:1px solid rgba(255,255,255,.18)!important;padding-left:20px!important;padding-right:20px!important;}
  .nav-more-toggle[aria-expanded="true"]{background:rgba(255,255,255,.12);border-bottom-color:#5ab0ff;}
  .nav-more-menu{display:none;position:absolute;z-index:450;right:0;top:100%;min-width:210px;background:#fff;border:1px solid var(--borda);border-radius:0 0 8px 8px;box-shadow:0 8px 22px rgba(0,0,0,.22);padding:6px;}
  .nav-more.open .nav-more-menu{display:block;}
  .nav-more-menu button{display:block;width:100%;color:var(--azul-esc);text-align:left;border:0;border-radius:5px;padding:10px 12px;border-bottom:0;}
  .nav-more-menu button:hover{color:var(--azul-esc);background:var(--azul-claro);}
  .nav-more-menu button.active{color:var(--azul-esc);background:var(--azul-claro);border-left:3px solid var(--azul);border-bottom:0;}
  @media(max-width:760px){.nav-more{margin-left:0}.nav-more-menu{left:0;right:auto}.nav-more-toggle{border-left:0!important;}}
  main{padding:22px;max-width:1280px;margin:0 auto;flex:1 1 auto;min-width:0;}
  .view{display:none;}
  .view.active{display:block;}
  h2.sec{font-size:17px;margin-bottom:4px;color:var(--azul-esc);}
  p.hint{color:var(--cinza);font-size:12.5px;margin-bottom:16px;}

  .grid{display:grid;gap:14px;}
  .kpis{grid-template-columns:repeat(auto-fit,minmax(170px,1fr));}
  .kpi{background:#fff;border:1px solid var(--borda);border-radius:9px;padding:16px;border-left:4px solid var(--azul);}
  .kpi .v{font-size:26px;font-weight:700;color:var(--azul-esc);}
  .kpi .l{font-size:12px;color:var(--cinza);margin-top:3px;}
  .kpi.warn{border-left-color:var(--laranja);}
  .kpi.warn .v{color:var(--laranja);}
  .kpi.bad{border-left-color:var(--vermelho);}
  .kpi.bad .v{color:var(--vermelho);}
  .kpi.ok{border-left-color:var(--verde);}
  label{display:block;font-size:12px;font-weight:600;color:var(--cinza);margin-bottom:4px;}
  input,select,textarea{width:100%;padding:8px 10px;border:1px solid var(--borda);border-radius:6px;font-size:13px;font-family:inherit;background:#fff;}
  input:focus,select:focus,textarea:focus{outline:none;border-color:var(--azul);box-shadow:0 0 0 2px var(--azul-claro);}
  .form-row{display:grid;gap:12px;margin-bottom:12px;}
  .c2{grid-template-columns:1fr 1fr;}
  .c3{grid-template-columns:1fr 1fr 1fr;}
  .c4{grid-template-columns:1fr 1fr 1fr 1fr;}
  @media(max-width:760px){.c2,.c3,.c4{grid-template-columns:1fr;}}

  table{width:100%;border-collapse:collapse;font-size:12.5px;}
  th{background:var(--cinza-claro);text-align:left;padding:9px 10px;font-size:11px;text-transform:uppercase;letter-spacing:.3px;color:var(--cinza);border-bottom:2px solid var(--borda);}
  td{padding:8px 10px;border-bottom:1px solid var(--borda);}
  tr:hover td{background:#fafbfc;}
  .tbl-wrap{overflow-x:auto;}
  .tag{display:inline-block;padding:2px 8px;border-radius:11px;font-size:11px;font-weight:600;}
  .tag.entrada{background:var(--verde-claro);color:var(--verde);}
  .tag.saida{background:var(--vermelho-claro);color:var(--vermelho);}
  .tag.transferencia{background:var(--laranja-claro);color:var(--laranja);}
  .tag.montagem{background:var(--azul-claro);color:var(--azul);}
  .stk-ok{color:var(--verde);font-weight:700;}
  .stk-baixo{color:var(--laranja);font-weight:700;}
  .stk-zero{color:#6b5200;background:#fff3a6!important;font-weight:700;}
  .toolbar{display:flex;gap:10px;flex-wrap:wrap;align-items:flex-end;margin-bottom:14px;}
  .toolbar > div{flex:1;min-width:140px;}
  .empty{text-align:center;color:var(--cinza);padding:28px;font-style:italic;}
  .toast{position:fixed;bottom:22px;right:22px;background:var(--azul-esc);color:#fff;padding:12px 18px;border-radius:7px;font-size:13px;box-shadow:0 4px 14px rgba(0,0,0,.25);opacity:0;transform:translateY(12px);transition:.25s;z-index:999;}
  .toast.show{opacity:1;transform:translateY(0);}
  .toast.erro{background:var(--vermelho);}
  .toast.ok{background:var(--verde);}
  .modal-bg{display:none;position:fixed;inset:0;background:rgba(0,0,0,.45);z-index:500;align-items:flex-start;justify-content:center;padding:40px 16px;overflow:auto;}
  .modal-bg.show{display:flex;}
  .modal{background:#fff;border-radius:10px;width:100%;max-width:640px;padding:22px;}
  .modal h3{font-size:15px;margin-bottom:14px;color:var(--azul-esc);}
  .modal-actions{display:flex;justify-content:flex-end;gap:9px;margin-top:16px;}
  .bom-row{display:grid;grid-template-columns:2fr 90px 36px;gap:8px;margin-bottom:7px;align-items:center;}
  .pill{font-size:11px;background:var(--cinza-claro);border:1px solid var(--borda);border-radius:11px;padding:2px 9px;color:var(--cinza);}
  .bom-preview{background:var(--azul-claro);border:1px dashed var(--azul);border-radius:7px;padding:11px;margin-top:8px;font-size:12px;}
  .bom-preview table{font-size:11.5px;}
  .bom-preview th{background:transparent;}
  .info-box{background:var(--azul-claro);border-left:3px solid var(--azul);padding:10px 12px;border-radius:5px;font-size:12px;color:var(--azul-esc);margin-bottom:14px;}
  .row-del{color:var(--vermelho);cursor:pointer;font-weight:700;}
