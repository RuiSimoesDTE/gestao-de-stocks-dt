function marcarSaidasParaFolha(etiqueta, dataIni, dataFim){
  if(!etiqueta || !confirm(`Marcar todas as saÃ­das entre ${dataIni} e ${dataFim} com etiqueta "${etiqueta}"?\n\nIsto vai impedir que sejam contadas em folhas futuras com outras etiquetas.`)) return;
