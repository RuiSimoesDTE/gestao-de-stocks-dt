<script>
var REL_STATE={};

function gerarRelatorio(){
  const ini=document.getElementById('rel-ini').value;
  const fim=document.getElementById('rel-fim').value;
  const q=(document.getElementById('rel-q').value||'').trim().toLowerCase();
  if(!ini||!fim){alert('Define data inÃ­cio e fim'); return;}
  const matsMap={}; for(const m of DB.materiais) matsMap[m.id]=m;
  function matchQ(mv){
    if(!q) return true;
    const m=matsMap[mv.mat]||{};
    const blob=((m.codigo||'')+' '+(m.sap||'')+' '+(m.desc||'')+' '+(mv.obs||'')+' '+(mv.dest||'')+' '+(mv.origem||'')).toLowerCase();
    return blob.includes(q);
  }
  const movs=DB.movimentos.filter(mv=>{
    const d=mv.data||'';
    if(d<ini||d>fim) return false;
    return matchQ(mv);
  });
  const ents=movs.filter(m=>m.tipo==='entrada');
  /* 18/09/2026 (A6/B3): as saÃ­das contam sÃ³ o consumo real; ajustes, roubo e transferÃªncias ficam Ã  parte. */
  const saisTodas=movs.filter(m=>m.tipo==='saida');
  const sais=saisTodas.filter(eConsumoReal),saisOutras=saisTodas.length-sais.length;
  
  document.getElementById('rel-conteudo').style.display='block';
  
  // KPIs
  const matsSet=new Set(movs.map(m=>m.mat));
  const posSet=new Set(movs.filter(m=>m.pedido).map(m=>m.pedido));
  /* 18/09/2026 (B12): nÃ£o se somam quantidades de unidades diferentes (m, un, kg). */
  document.getElementById('rel-kpi-ent').textContent=ents.length+' mov â€¢ '+new Set(ents.map(x=>x.mat)).size+' materiais';
  document.getElementById('rel-kpi-sai').textContent=sais.length+' mov de consumo'+(saisOutras?' (+'+saisOutras+' ajustes/transf.)':'');
  document.getElementById('rel-kpi-mat').textContent=matsSet.size+'';
  document.getElementById('rel-kpi-pos').textContent=posSet.size+'';
  
  // Top saÃ­das
  const aggS={};
  for(const mv of sais){
    if(!aggS[mv.mat]) aggS[mv.mat]={qt:0,n:0};
    aggS[mv.mat].qt+=mv.qtd||0; aggS[mv.mat].n++;
  }
  const stockAtual={};
  for(const mv of DB.movimentos){
    stockAtual[mv.mat]=stockAtual[mv.mat]||0;
    if(mv.tipo==='entrada') stockAtual[mv.mat]+=mv.qtd||0;
    else if(mv.tipo==='saida') stockAtual[mv.mat]-=mv.qtd||0;
  }
  const topS=Object.entries(aggS).map(([mid,v])=>[mid,v]).sort((a,b)=>b[1].qt-a[1].qt).slice(0,20);
  const tbS=document.querySelector('#rel-top-sai tbody'); tbS.innerHTML='';
  for(const [mid,v] of topS){
    const m=matsMap[mid]||{}; const tr=document.createElement('tr');
    tr.innerHTML=`<td>${escapeHtml(m.codigo||'')}</td><td>${escapeHtml(m.sap||'')}</td><td>${escapeHtml(m.desc||'')}</td><td style="text-align:right;font-weight:bold">${fmt(v.qt)}</td><td>${escapeHtml(m.un||'')}</td><td>${v.n}</td><td style="text-align:right">${fmt(stockAtual[mid]||0)}</td>`;
    tbS.appendChild(tr);
  }
  
  // Top entradas
  const aggE={};
  for(const mv of ents){
    if(!aggE[mv.mat]) aggE[mv.mat]={qt:0,n:0,forn:mv.origem||''};
    aggE[mv.mat].qt+=mv.qtd||0; aggE[mv.mat].n++;
  }
  const topE=Object.entries(aggE).sort((a,b)=>b[1].qt-a[1].qt).slice(0,20);
  const tbE=document.querySelector('#rel-top-ent tbody'); tbE.innerHTML='';
  for(const [mid,v] of topE){
    const m=matsMap[mid]||{}; const tr=document.createElement('tr');
    tr.innerHTML=`<td>${escapeHtml(m.codigo||'')}</td><td>${escapeHtml(m.sap||'')}</td><td>${escapeHtml(m.desc||'')}</td><td style="text-align:right;font-weight:bold">${fmt(v.qt)}</td><td>${escapeHtml(m.un||'')}</td><td>${v.n}</td><td>${escapeHtml(v.forn)}</td>`;
    tbE.appendChild(tr);
  }
  
  // Por destino
  const aggD={};
  for(const mv of sais){
    const dst=mv.dest||'(sem destino)';
    if(!aggD[dst]) aggD[dst]={n:0,qt:0};
    aggD[dst].n++; aggD[dst].qt+=mv.qtd||0;
  }
  const tbD=document.querySelector('#rel-por-dest tbody'); tbD.innerHTML='';
  for(const [dst,v] of Object.entries(aggD).sort((a,b)=>b[1].qt-a[1].qt)){
    const tr=document.createElement('tr');
    tr.innerHTML=`<td>${escapeHtml(dst)}</td><td style="text-align:right">${v.n}</td><td style="text-align:right;font-weight:bold">${fmt(v.qt)}</td>`;
    tbD.appendChild(tr);
  }
  
  // Por dia
  const aggDay={};
  for(const mv of movs){
    const d=mv.data||'';
    if(!aggDay[d]) aggDay[d]={eN:0,eQ:0,sN:0,sQ:0};
    if(mv.tipo==='entrada'){aggDay[d].eN++;aggDay[d].eQ+=mv.qtd||0;}
    else if(mv.tipo==='saida'){aggDay[d].sN++;aggDay[d].sQ+=mv.qtd||0;}
  }
  const tbDay=document.querySelector('#rel-por-dia tbody'); tbDay.innerHTML='';
  for(const d of Object.keys(aggDay).sort()){
    const v=aggDay[d]; const tr=document.createElement('tr');
    tr.innerHTML=`<td>${d}</td><td style="text-align:right">${v.eN}</td><td style="text-align:right;color:#0a8043;font-weight:bold">${fmt(v.eQ)}</td><td style="text-align:right">${v.sN}</td><td style="text-align:right;color:#c00;font-weight:bold">${fmt(v.sQ)}</td>`;
    tbDay.appendChild(tr);
  }
  
  // Stock atual dos materiais com movimento
  const tbStock=document.querySelector('#rel-stock tbody'); tbStock.innerHTML='';
  const matsList=Array.from(matsSet).map(mid=>matsMap[mid]).filter(Boolean);
  matsList.sort((a,b)=>(stockAtual[b.id]||0)-(stockAtual[a.id]||0));
  for(const m of matsList){
    const s=stockAtual[m.id]||0; const tr=document.createElement('tr');
    const cor=s<0?'#fcc':(s===0?'#fff2cc':'');
    tr.innerHTML=`<td>${escapeHtml(m.codigo||'')}</td><td>${escapeHtml(m.sap||'')}</td><td>${escapeHtml(m.desc||'')}</td><td>${escapeHtml(m.un||'')}</td><td style="text-align:right;font-weight:bold;background:${cor}">${fmt(s)}</td><td>${escapeHtml(m.tipo||'')}</td><td>${escapeHtml(m.fornecedor||'')}</td>`;
    tbStock.appendChild(tr);
  }
  
  REL_STATE={ents,sais,movs,ini,fim,q,matsMap,stockAtual};
}

