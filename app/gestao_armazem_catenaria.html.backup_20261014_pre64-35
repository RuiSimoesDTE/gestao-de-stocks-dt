let csvPendente=null;
function parseCSV(txt){
  txt=txt.replace(/^ï»¿/,'');
  const linhas=txt.split(/\r?\n/).filter(l=>l.trim()!=='');
  if(linhas.length<2)return null;
  const sep=(linhas[0].split(';').length>linhas[0].split(',').length)?';':',';
  const split=l=>{
    const out=[];let cur='',dentro=false;
    for(let i=0;i<l.length;i++){
      const ch=l[i];
      if(ch==='"'){ if(dentro&&l[i+1]==='"'){cur+='"';i++;}else dentro=!dentro; }
      else if(ch===sep&&!dentro){out.push(cur);cur='';}
      else cur+=ch;
    }
    out.push(cur);return out.map(s=>s.trim());
  };
  const head=split(linhas[0]).map(h=>h.toLowerCase());
  const idx=nomes=>head.findIndex(h=>nomes.includes(h));
  const iCod=idx(['codigo','cÃ³digo','material','cod','artigo','referencia','referÃªncia']);
  const iQtd=idx(['quantidade','qtd','quantity','qty','qtde']);
  const iDes=idx(['descricao','descriÃ§Ã£o','designacao','designaÃ§Ã£o','description','desc']);
  const iArm=idx(['armazem','armazÃ©m','warehouse','centro','deposito','depÃ³sito']);
  const iDoc=idx(['documento','doc','guia','ordem','nota','guia/fatura','fatura']);
  const iPed=idx(['pedido','pedido de compra','pedido compra','documento de compras','documento de compra','purchase order','po','nÂº pedido']);
  const iUn=idx(['unidade','un','um','uom']);
  const iForn=idx(['fornecedor','forn','supplier','vendor','nome do fornecedor']);
  const iRec=idx(['recebida','recebido','entregue','quantidade recebida','qtd recebida']);
  const iPreco=idx(['preco','preÃ§o','preco unitario','preÃ§o unitÃ¡rio','valor unitario','valor unitÃ¡rio','preco liquido','preÃ§o lÃ­quido']);
  const iUPreco=idx(['unidade preco','unidade preÃ§o','por']);
  const iData=idx(['data','data do documento','data documento','data de lanÃ§amento','data lanÃ§amento','data de lancamento','data entrada','data da entrada']);
  const iItem=idx(['item','item do pedido','item pedido','it.','posiÃ§Ã£o','posicao']);
  const num=v=>{const s=String(v||'').replace(/\s|â‚¬/g,'');
    if(s.includes(','))return parseFloat(s.replace(/\./g,'').replace(',','.'));
    if(/^-?\d{1,3}(\.\d{3})+$/.test(s))return parseFloat(s.replace(/\./g,''));   // 1.003 / 21.650 = milhares
    return parseFloat(s);};
  if(iCod<0||iQtd<0)return {erro:'NÃ£o foi possÃ­vel identificar as colunas de cÃ³digo e quantidade.'};
  const rows=[];
  for(let i=1;i<linhas.length;i++){
    const c=split(linhas[i]);
    const codigo=(c[iCod]||'').trim();
    const qtd=num(c[iQtd]);   // 18/09/2026 (A5/B7): "1.200,000" = 1200, nÃ£o 1,2
    if(!codigo||!(qtd>0))continue;
    rows.push({codigo,qtd,desc:iDes>=0?(c[iDes]||'').trim():'',
      arm:iArm>=0?(c[iArm]||'').trim():'',doc:iDoc>=0?(c[iDoc]||'').trim():'',
      pedido:iPed>=0?(c[iPed]||'').trim():'',
      forn:iForn>=0?(c[iForn]||'').trim():'',
      rec:iRec>=0?(num(c[iRec])||0):0,
      data:iData>=0?dataDoFicheiro(c[iData]):'',item:iItem>=0?String(c[iItem]||'').trim():'',
      preco:iPreco>=0&&num(c[iPreco])>0?+(num(c[iPreco])/(iUPreco>=0&&num(c[iUPreco])>0?num(c[iUPreco]):1)).toFixed(4):null,
      un:iUn>=0?(c[iUn]||'').trim():''});
  }
  return {rows};
}
