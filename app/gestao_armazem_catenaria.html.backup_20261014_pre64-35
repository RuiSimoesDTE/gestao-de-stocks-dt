    '<tr><td>'+escapeHtml(x.nome||'â€”')+'</td><td><b>'+escapeHtml(x.novo)+'</b></td><td><b>'+escapeHtml(x.antigo)+'</b></td><td>'+(x.usado?'<span class="tag entrada">sim</span>':'')+'</td></tr>').join('');
