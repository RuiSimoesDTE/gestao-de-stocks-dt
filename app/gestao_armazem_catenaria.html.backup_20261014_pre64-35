.btn { background: linear-gradient(135deg, var(--azul), #0d6cc9); color: #fff; }
.btn:hover { background: linear-gradient(135deg, #0d6cc9, var(--azul)); }
/* Cards */
.card {
  background: var(--fundo);
  border: 1px solid var(--borda);
  border-radius: 8px;
  box-shadow: var(--sombra-f);
  padding: 18px;
}
.card:hover { box-shadow: 0 4px 16px rgba(0,0,0,0.12); }
/* Tabelas */
table { border-collapse: collapse; width: 100%; }
thead { background: var(--azul-claro); }
thead th { color: var(--azul-esc); font-weight: 600; padding: 12px; border-bottom: 2px solid var(--azul); }
tbody tr { border-bottom: 1px solid var(--borda); }
tbody tr:nth-child(even) { background: var(--cinza-claro); }
tbody td { padding: 10px 12px; }
tbody tr:hover { background: #f0f4f9; }
/* Inputs */
input, select, textarea {
  border: 1px solid var(--borda);
  border-radius: 6px;
  padding: 10px 12px;
  font-size: 14px;
  transition: all 0.2s;
}
input:focus, select:focus, textarea:focus {
  outline: none;
  border-color: var(--azul);
  box-shadow: 0 0 0 3px rgba(11, 91, 168, 0.1);
}
/* Modais */
.modal {
  border-radius: 12px;
  box-shadow: 0 20px 60px rgba(0,0,0,0.3);
  animation: slideIn 0.3s ease;
}
@keyframes slideIn {
  from { opacity: 0; transform: translateY(-20px); }
  to { opacity: 1; transform: translateY(0); }
}
/* Tags/Pills */
.tag, .pill {
  border-radius: 20px;
  padding: 4px 12px;
  font-size: 12px;
  font-weight: 500;
}
.tag.verde, .tag.material { background: var(--verde-claro); color: var(--verde); }
.tag.laranja { background: var(--laranja-claro); color: var(--laranja); }
/* Details/AcordeÃ£o */
details { border: 1px solid var(--borda); border-radius: 6px; padding: 0; margin: 8px 0; }
summary { padding: 12px; cursor: pointer; user-select: none; font-weight: 500; }
details[open] summary { background: var(--azul-claro); }
summary:hover { background: var(--cinza-claro); }
/* Info boxes */
.info-box {
  background: var(--azul-claro);
  border-left: 4px solid var(--azul);
  border-radius: 6px;
  padding: 12px 14px;
  font-size: 14px;
