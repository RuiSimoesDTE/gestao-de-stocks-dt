      ${detalhe.map(d=>`<tr><td><b>${escapeHtml(d.r.codigo)}</b></td>
        <td>${escapeHtml(d.m?d.m.desc:d.r.desc||'(novo material)')}</td>
        <td>${fmt(d.r.qtd)}</td><td>${escapeHtml(d.arm)}</td>
        <td>${escapeHtml(d.r.pedido||'')}</td><td>${escapeHtml(d.r.doc)}</td><td>${d.estado}</td></tr>`).join('')}
      </table></div>
      <button class="btn verde" style="margin-top:12px" onclick="confirmarImportSap()">âœ” Confirmar importaÃ§Ã£o</button>`;
  };
  reader.readAsText(f,'UTF-8');
}
